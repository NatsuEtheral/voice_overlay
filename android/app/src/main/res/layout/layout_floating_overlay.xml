<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- STATE 1: Collapsed Floating Bubble (64dp x 64dp) -->
    <FrameLayout
        android:id="@+id/layout_bubble"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_floating_bubble"
        android:elevation="12dp"
        android:visibility="visible">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_mic"
            android:contentDescription="Record Voice" />
    </FrameLayout>

    <!-- STATE 2: Recording Pill (280dp x 68dp) -->
    <LinearLayout
        android:id="@+id/layout_recording"
        android:layout_width="280dp"
        android:layout_height="68dp"
        android:background="@drawable/bg_floating_pill"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:elevation="14dp"
        android:visibility="gone">

        <!-- Red Recording Dot -->
        <View
            android:id="@+id/recording_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_floating_bubble"
            android:backgroundTint="#EF4444" />

        <!-- Duration Text -->
        <TextView
            android:id="@+id/tv_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="00:00"
            android:textColor="#EF4444"
            android:textStyle="bold"
            android:textSize="13sp" />

        <!-- 120Hz Waveform Canvas -->
        <com.offlinestt.voicenotes.overlay.WaveformCanvasView
            android:id="@+id/waveform_view"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />

        <!-- Stop Button -->
        <FrameLayout
            android:id="@+id/btn_stop"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_floating_bubble"
            android:backgroundTint="#6366F1">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_stop"
                android:contentDescription="Stop and Transcribe" />
        </FrameLayout>

        <!-- Cancel Button -->
        <ImageView
            android:id="@+id/btn_cancel"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_close"
            android:alpha="0.6"
            android:contentDescription="Cancel Recording" />
    </LinearLayout>

    <!-- STATE 3: Transcribing Spinner (220dp x 60dp) -->
    <LinearLayout
        android:id="@+id/layout_transcribing"
        android:layout_width="220dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_floating_pill"
        android:orientation="horizontal"
        android:gravity="center"
        android:elevation="14dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:indeterminate="true"
            android:indeterminateTint="#6366F1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Transcribing..."
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- STATE 4: Result Window (310dp x 180dp) -->
    <LinearLayout
        android:id="@+id/layout_result"
        android:layout_width="310dp"
        android:layout_height="180dp"
        android:background="@drawable/bg_floating_card"
        android:orientation="vertical"
        android:padding="12dp"
        android:elevation="16dp"
        android:visibility="gone">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Copied Badge -->
            <LinearLayout
                android:id="@+id/badge_copied"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_floating_pill"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_check" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Copied"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Clean Speech Switch -->
            <TextView
                android:id="@+id/btn_toggle_clean"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clean: ON"
                android:textColor="#818CF8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:padding="4dp" />

            <!-- Close Result Button -->
            <ImageView
                android:id="@+id/btn_close_result"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_close"
                android:alpha="0.7"
                android:contentDescription="Close" />
        </LinearLayout>

        <!-- Transcribed Text Content (Scrollable) -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tv_transcribed_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your dictated speech appears here..."
                android:textColor="#E2E8F0"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />
        </ScrollView>

        <!-- Bottom Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Save to Note Button -->
            <LinearLayout
                android:id="@+id/btn_save_note"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_floating_pill"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/iv_save_icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_save" />

                <TextView
                    android:id="@+id/tv_save_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Save Note"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Re-copy Button -->
            <ImageView
                android:id="@+id/btn_recopy"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_floating_pill"
                android:padding="7dp"
                android:src="@drawable/ic_copy"
                android:contentDescription="Copy Text" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
